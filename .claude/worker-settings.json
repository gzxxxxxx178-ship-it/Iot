{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(rg *)",
      "Bash(bash -n *)",
      "Bash(./mvnw *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(node *)",
      "Bash(java *)",
      "Bash(javac *)",
      "Bash(arduino-cli compile *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/application-dev.properties)",
      "Read(**/secrets.h)",
      "Read(**/client_secret_*.json)",
      "Edit(AGENTS.md)",
      "Write(AGENTS.md)",
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(**/CLAUDE.md)",
      "Write(**/CLAUDE.md)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(.ai/tasks/**)",
      "Write(.ai/tasks/**)",
      "Edit(scripts/claude_worker.sh)",
      "Write(scripts/claude_worker.sh)",
      "Edit(docs/CODEX_CLAUDE_WORKFLOW.md)",
      "Write(docs/CODEX_CLAUDE_WORKFLOW.md)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git tag *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sftp *)",
      "Bash(rsync *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(rm *)",
      "Bash(shred *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(brew *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npm publish *)",
      "Bash(npx *)",
      "Bash(./mvnw *deploy*)",
      "Bash(mvn *deploy*)",
      "Bash(mysql *)",
      "Bash(redis-cli *)",
      "Bash(mosquitto_pub *)",
      "Bash(mosquitto_sub *)",
      "Bash(arduino-cli upload *)",
      "Bash(docker *)",
      "Bash(kubectl *)",
      "Bash(terraform *)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/claude_worker_guard.sh"
          }
        ]
      }
    ]
  }
}
